{
  "experiment": "A4-smoke-fixedp",
  "arch": "c2f",
  "description": "CPU smoke test of the c2f trainer (tiny all-parts global: GDN + SWA + attention, shared loop x2, ternary core, MoE core-only; r_b = 2 shared contractive decoder with per-pass loss). Not an experiment; never registered.",
  "model": {
    "patching": "fixed",
    "patch_size": 4,
    "d_local": 32,
    "local_heads": 2,
    "local_mlp_hidden": 64,
    "local_window": 16,
    "local_encoder": ["conv", "gdn"],
    "refine_blocks": ["lswa"],
    "refine_passes": 2,
    "refine_shared": true,
    "refine_contractive": true,
    "refine_aux_weight": 0.5,
    "global_model": {
      "d_model": 64,
      "n_heads": 2,
      "mlp_hidden": 128,
      "window": 16,
      "ternary": true,
      "prelude": ["swa"],
      "core": ["gdn", "swa"],
      "coda": ["attn"],
      "loops": 2,
      "loops_min": 2,
      "loops_max": 2,
      "bptt_loops": 2,
      "ternary_fp_ends": true,
      "inject_contractive": true,
      "moe_experts": 4,
      "moe_top_k": 2,
      "moe_hidden": 64,
      "moe_core_only": true,
      "ternary_mixer": false
    }
  },
  "train": {
    "dataset": "code-py-v1-bytes",
    "seq_len": 256,
    "batch_size": 4,
    "max_bytes": 20480,
    "lr": 0.003,
    "min_lr_frac": 0.1,
    "warmup_steps": 5,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "eval_every": 10,
    "eval_seqs": 4,
    "final_eval_seqs": 8,
    "eval_passes": [1, 3],
    "sample_bytes": 24,
    "print_every": 1,
    "seed": 0
  }
}

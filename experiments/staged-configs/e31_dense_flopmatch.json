{
  "experiment": "E31",
  "description": "Dense (6 full-attention blocks) with mlp_hidden 888 so train FLOPs/token match E1 (91,027,800). Control for 'E1 wins at fewer FLOPs'. LR_E10.",
  "model": {
    "vocab_size": 8192,
    "d_model": 384,
    "n_heads": 6,
    "mlp_hidden": 888,
    "window": 256,
    "max_seq_len": 1024,
    "ternary": false,
    "prelude": [
      "attn",
      "attn",
      "attn",
      "attn",
      "attn",
      "attn"
    ],
    "core": [],
    "coda": []
  },
  "train": {
    "dataset": "code-py-v1",
    "seq_len": 1024,
    "batch_size": 32,
    "max_tokens": 200000000,
    "lr": 0.003,
    "min_lr_frac": 0.1,
    "warmup_steps": 300,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "eval_every": 250,
    "eval_seqs": 128,
    "seed": 0
  }
}

{
  "experiment": "INK_e2_fixed_r4",
  "description": "SQ266 fixed-r loop (Inkling 2 Mini trains at fixed r=3): loops=loops_min=loops_max=bptt_loops=4, 20M tokens, lr 6e-3.",
  "model": {
    "vocab_size": 8192,
    "d_model": 384,
    "n_heads": 6,
    "mlp_hidden": 1024,
    "prelude": [
      "swa"
    ],
    "core": [
      "gdn",
      "gdn",
      "swa"
    ],
    "coda": [
      "attn"
    ],
    "loops": 4,
    "loops_min": 4,
    "loops_max": 4,
    "bptt_loops": 4,
    "window": 256,
    "max_seq_len": 1024,
    "ternary": false
  },
  "train": {
    "dataset": "code-py-v1",
    "seq_len": 1024,
    "batch_size": 32,
    "max_tokens": 20000000,
    "lr": 0.006,
    "min_lr_frac": 0.1,
    "warmup_steps": 300,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "eval_every": 250,
    "eval_seqs": 128,
    "seed": 0,
    "eval_loops": [
      1,
      2,
      3,
      4,
      6,
      8,
      12
    ]
  }
}

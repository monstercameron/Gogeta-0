 # ----------------------------------------------------------------------------- pieces
+_FLEX = None
+
+
+def _flex_attention():
+    """torch.compile'd flex_attention (eager flex is a slow reference); built on first use."""
+    global _FLEX
+    if _FLEX is None:
+        from torch.nn.attention.flex_attention import flex_attention
+        _FLEX = torch.compile(flex_attention, dynamic=False)
+    return _FLEX
+

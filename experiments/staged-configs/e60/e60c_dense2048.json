{
  "experiment": "E60c",
  "description": "Code-MoE stage 1 control: dense E1 with SwiGLU mlp_hidden 2048, total-param matched to E60a (-0.05%) at 1.47x E1's FLOPs.",
  "model": {
    "vocab_size": 8192,
    "d_model": 384,
    "n_heads": 6,
    "mlp_hidden": 2048,
    "prelude": [
      "swa",
      "gdn",
      "gdn",
      "swa",
      "gdn",
      "attn"
    ],
    "core": [],
    "coda": [],
    "window": 256,
    "max_seq_len": 1024,
    "ternary": false
  },
  "train": {
    "dataset": "code-py-v1",
    "seq_len": 1024,
    "batch_size": 32,
    "max_tokens": 200000000,
    "lr": 0.006,
    "min_lr_frac": 0.1,
    "warmup_steps": 300,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "eval_every": 250,
    "eval_seqs": 128,
    "seed": 0
  }
}

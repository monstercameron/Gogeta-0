{
 "experiment": "SQ401d",
 "description": "SQ401: A2s with a dense core SwiGLU of hidden 2048 (the MoE bank total width of A3m), prelude/coda keep 1024. Capacity control for C206. 20M tokens of code-py-v2.",
 "model": {
  "vocab_size": 8192,
  "d_model": 384,
  "n_heads": 6,
  "mlp_hidden": 1024,
  "window": 256,
  "max_seq_len": 1024,
  "ternary": true,
  "prelude": [
   "swa"
  ],
  "core": [
   "gdn",
   "gdn",
   "swa",
   "gdn",
   "gdn",
   "swa"
  ],
  "coda": [
   "attn"
  ],
  "loops": 2,
  "loops_min": 2,
  "loops_max": 2,
  "bptt_loops": 2,
  "ternary_fp_ends": true,
  "inject_contractive": true,
  "core_mlp_hidden": 2048
 },
 "train": {
  "dataset": "code-py-v2",
  "seq_len": 1024,
  "batch_size": 32,
  "max_tokens": 20000000,
  "lr": 0.006,
  "min_lr_frac": 0.1,
  "warmup_steps": 300,
  "weight_decay": 0.1,
  "beta1": 0.9,
  "beta2": 0.95,
  "grad_clip": 1.0,
  "eval_every": 250,
  "eval_seqs": 128,
  "seed": 0
 }
}
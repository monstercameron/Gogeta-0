{
  "experiment": "A3m",
  "description": "A3 all-parts assembly (A3m): A2s plus a ternary MoE FFN in the shared core (4 experts x 512, top-2: active FFN width 1024 = the dense FFN, so matched active FLOPs) to give the loop unique parameters. 200M tokens via --max-tokens, lr via --lr, code-py-v2.",
  "model": {
    "vocab_size": 8192,
    "d_model": 384,
    "n_heads": 6,
    "mlp_hidden": 1024,
    "window": 256,
    "max_seq_len": 1024,
    "ternary": true,
    "prelude": [
      "swa"
    ],
    "core": [
      "gdn",
      "gdn",
      "swa",
      "gdn",
      "gdn",
      "swa"
    ],
    "coda": [
      "attn"
    ],
    "loops": 2,
    "loops_min": 2,
    "loops_max": 2,
    "bptt_loops": 2,
    "ternary_fp_ends": true,
    "inject_contractive": true,
    "moe_experts": 4,
    "moe_top_k": 2,
    "moe_hidden": 512,
    "moe_core_only": true
  },
  "train": {
    "dataset": "code-py-v2",
    "seq_len": 1024,
    "batch_size": 32,
    "max_tokens": 20000000,
    "lr": 0.006,
    "min_lr_frac": 0.1,
    "warmup_steps": 300,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "eval_every": 250,
    "eval_seqs": 128,
    "seed": 0
  }
}

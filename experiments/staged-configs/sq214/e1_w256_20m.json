{
  "experiment": "SQ214w256",
  "description": "SQ214 window sweep: E1 (configs/e1_hybrid.json) with the two SWA layers' window = 256 (E1 default 256; 1024 = T, i.e. full causal attention). Everything else identical. 20M tokens, lr 6e-3 (E1's K7 best).",
  "model": {
    "vocab_size": 8192,
    "d_model": 384,
    "n_heads": 6,
    "mlp_hidden": 1024,
    "prelude": [
      "swa",
      "gdn",
      "gdn",
      "swa",
      "gdn",
      "attn"
    ],
    "core": [],
    "coda": [],
    "window": 256,
    "max_seq_len": 1024,
    "ternary": false
  },
  "train": {
    "dataset": "code-py-v1",
    "seq_len": 1024,
    "batch_size": 32,
    "max_tokens": 20000000,
    "lr": 0.006,
    "min_lr_frac": 0.1,
    "warmup_steps": 300,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "eval_every": 250,
    "eval_seqs": 128,
    "seed": 0
  }
}

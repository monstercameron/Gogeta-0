{
  "experiment": "E60b",
  "description": "Code-MoE stage 1 control: E60a with the router frozen at its random init (requires_grad=False) and balance/z-loss off (coef 0, per experiments/design/code-moe-draft.md); tests whether learned routing matters.",
  "model": {
    "vocab_size": 8192,
    "d_model": 384,
    "n_heads": 6,
    "mlp_hidden": 1024,
    "prelude": [
      "swa",
      "gdn",
      "gdn",
      "swa",
      "gdn",
      "attn"
    ],
    "core": [],
    "coda": [],
    "window": 256,
    "max_seq_len": 1024,
    "ternary": false,
    "moe_experts": 4,
    "moe_top_k": 2,
    "moe_hidden": 512,
    "moe_balance_coef": 0.0,
    "moe_zloss_coef": 0.0,
    "moe_router_frozen": true,
    "moe_impl": "gather"
  },
  "train": {
    "dataset": "code-py-v1",
    "seq_len": 1024,
    "batch_size": 32,
    "max_tokens": 200000000,
    "lr": 0.006,
    "min_lr_frac": 0.1,
    "warmup_steps": 300,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "eval_every": 250,
    "eval_seqs": 128,
    "seed": 0
  }
}

+def env_info() -> dict:
+    """Run-time environment, recorded in meta.json["env"] (the audit's manifest reads it from there; never typed)."""
+    info = {"python": platform.python_version(), "platform": platform.platform()}
+    try:
+        import torch
+
+        info.update(torch=torch.__version__, cuda=torch.version.cuda, cudnn=str(torch.backends.cudnn.version()))
+        if torch.cuda.is_available():
+            info.update(gpu=torch.cuda.get_device_name(0), gpu_capability=list(torch.cuda.get_device_capability(0)))
+    except Exception as e:  # never fail a run over provenance
+        info["torch_error"] = f"{type(e).__name__}: {e}"
+    try:
+        o = subprocess.run(["nvidia-smi", "--query-gpu=driver_version", "--format=csv,noheader"],
+                           capture_output=True, text=True, timeout=15)
+        info["nvidia_driver"] = o.stdout.strip().splitlines()[0] if o.returncode == 0 and o.stdout.strip() else None
+    except Exception:
+        info["nvidia_driver"] = None
+    try:
+        o = subprocess.run([sys.executable, "-m", "pip", "freeze"], capture_output=True, text=True, timeout=60)
+        lines = sorted(l.strip() for l in o.stdout.splitlines() if l.strip())
+        info["pip_freeze_sha256"] = hashlib.sha256("
+".join(lines).encode()).hexdigest() if lines else None
+        info["n_packages"] = len(lines)
+    except Exception:
+        info["pip_freeze_sha256"] = None
+    info["env_vars"] = {k: os.environ.get(k) for k in ("GOGETA_TRACKER", "GOGETA_DATA", "CUBLAS_WORKSPACE_CONFIG")}
+    return info
+
+
 CODE_PATHS = ("gogeta", "configs", "tools", "tests", "requirements.txt")

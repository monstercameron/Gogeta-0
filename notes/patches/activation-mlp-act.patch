+class XIELU(nn.Module):
+    """xIELU (Huang & Schlag, arXiv 2411.13010) with trainable alpha_p, alpha_n (softplus-constrained, init 0.8, per layer).
+    x>0: alpha_p*x^2 + beta*x ; x<=0: alpha_n*expm1(x) - alpha_n*x + beta*x, with beta = 0.5 fixed (alpha_n offset by beta)."""
+
+    def __init__(self, alpha_p: float = 0.8, alpha_n: float = 0.8, beta: float = 0.5):
+        super().__init__()
+        inv = lambda v: math.log(math.expm1(v))  # inverse softplus
+        self.alpha_p = nn.Parameter(torch.tensor(inv(alpha_p)))
+        self.alpha_n = nn.Parameter(torch.tensor(inv(alpha_n - beta)))
+        self.beta = beta
+
+    def forward(self, x):
+        xf = x.float()  # expm1 near 0 loses precision in bf16
+        p = F.softplus(self.alpha_p.float())
+        n = F.softplus(self.alpha_n.float()) + self.beta
+        y = torch.where(xf > 0, p * xf * xf + self.beta * xf, n * torch.expm1(xf.clamp(max=0)) - n * xf + self.beta * xf)
+        return y.to(x.dtype)
+
+
 class SwiGLU(nn.Module):

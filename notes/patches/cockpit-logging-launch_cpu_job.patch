 while [[ $# -gt 0 ]]; do
@@ -106,6 +108,7 @@
 if (( NLIVE >= MAX_JOBS )); then
   print_plan "REFUSED" >&2
   echo "result     : not started: $NLIVE/$MAX_JOBS CPU jobs already alive (AGENTS.md 5 compute budget)." >&2

+def _save_resume(path, model, opt, step, tokens, flops, loop_rng, data, run_name):
+    """Atomic resumable checkpoint (model + optimizer + counters + all RNG states)."""
+    tmp = str(path) + ".tmp"
+    torch.save({"model": model.state_dict(), "opt": opt.state_dict(), "step": step, "tokens": tokens, "flops": flops,
+                "loop_rng": loop_rng.getstate(), "data_g": data.g.get_state(), "torch_rng": torch.get_rng_state(),
+                "cuda_rng": torch.cuda.get_rng_state(), "run_name": run_name}, tmp)
+    os.replace(tmp, path)
+

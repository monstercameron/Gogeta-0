{
  "experiment": "A1h",
  "description": "A1 assembly screen (A1h): F2 cell 111 (E27) with ONE compensation: loop shape: core of 4 blocks [gdn,gdn,swa,gdn] x r=3 (12 core applications + prelude + coda = 14); r ~ U{1..5}. 200M tokens via --max-tokens, lr 6e-3 via --lr, code-py-v2.",
  "model": {
    "vocab_size": 8192,
    "d_model": 384,
    "n_heads": 6,
    "mlp_hidden": 1024,
    "window": 256,
    "max_seq_len": 1024,
    "ternary": true,
    "prelude": [
      "swa"
    ],
    "core": [
      "gdn",
      "gdn",
      "swa",
      "gdn"
    ],
    "coda": [
      "attn"
    ],
    "loops": 3,
    "loops_min": 1,
    "loops_max": 5,
    "bptt_loops": 4
  },
  "train": {
    "dataset": "code-py-v2",
    "seq_len": 1024,
    "batch_size": 32,
    "max_tokens": 20000000,
    "lr": 0.006,
    "min_lr_frac": 0.1,
    "warmup_steps": 300,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "eval_every": 250,
    "eval_seqs": 128,
    "seed": 0
  }
}

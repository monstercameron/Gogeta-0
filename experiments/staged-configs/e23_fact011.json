{
  "experiment": "E23",
  "description": "Factorial cell 011 (GDN=0, loops=1, ternary=1): all full-attention mixers; shared loop (prelude 1, core 3 x r=4, coda 1, re-injection); ternary BitLinear. Depth budget 14 block applications, d=384, 20M tokens, deduplicated train set. LR comes from the cell's own G3 sweep (--lr), not from this file.",
  "model": {
    "vocab_size": 8192,
    "d_model": 384,
    "n_heads": 6,
    "mlp_hidden": 1024,
    "window": 256,
    "max_seq_len": 1024,
    "ternary": true,
    "prelude": [
      "attn"
    ],
    "core": [
      "attn",
      "attn",
      "attn"
    ],
    "coda": [
      "attn"
    ],
    "loops": 4,
    "loops_min": 1,
    "loops_max": 7,
    "bptt_loops": 4
  },
  "train": {
    "dataset": "code-py-v2",
    "seq_len": 1024,
    "batch_size": 32,
    "max_tokens": 20000000,
    "lr": 0.006,
    "min_lr_frac": 0.1,
    "warmup_steps": 300,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "eval_every": 250,
    "eval_seqs": 128,
    "seed": 0
  }
}

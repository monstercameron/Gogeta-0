{
  "experiment": "E16a",
  "description": "E14 winner (placeholder: r=2 shared, replace once E14 is scored) with an E2-style looped global core on patches: prelude [swa] -> core [gdn, gdn, swa] x r_g -> coda [attn], r_g ~ U{1..7}, bptt 4, eval r_g=4. [20M-byte sweep variant]",
  "budget": {
    "bytes": 20000000,
    "token_equivalents": 5354752,
    "steps": 153,
    "note": "max_bytes counts training byte positions (B x T per step); token_equivalents = bytes / 3.735 (measured val bytes per BPE token)"
  },
  "notes": "lr 0.006 = K7's tuned E1 value, NOT tuned for bytes: run the SQ188 LR check (20M-byte variants) first.",
  "model": {
    "vocab_size": 256,
    "max_seq_len": 4096,
    "d_model": 384,
    "n_heads": 6,
    "mlp_hidden": 1024,
    "prelude": [
      "swa"
    ],
    "core": [
      "gdn",
      "gdn",
      "swa"
    ],
    "coda": [
      "attn"
    ],
    "window": 256,
    "patch_size": 4,
    "d_local": 192,
    "local_heads": 3,
    "local_mlp_hidden": 512,
    "local_window": 64,
    "local_encoder": [
      "conv",
      "gdn"
    ],
    "refine_blocks": [
      "conv",
      "gdn"
    ],
    "refine_passes": 2,
    "refine_shared": true,
    "refine_update": "gated",
    "refine_loss": "linear",
    "decoder": "ar",
    "ternary": false,
    "loops": 4,
    "loops_min": 1,
    "loops_max": 7,
    "bptt_loops": 4
  },
  "train": {
    "dataset": "code-py-v1-bytes",
    "seq_len": 4096,
    "seq_len_unit": "bytes",
    "batch_size": 32,
    "max_bytes": 20000000,
    "lr": 0.006,
    "min_lr_frac": 0.1,
    "warmup_steps": 8,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "eval_every": 250,
    "eval_seqs": 128,
    "seed": 0,
    "eval_loops": [
      1,
      2,
      4,
      6,
      8
    ]
  }
}

--- a/tools/launch_cpu_job.sh
+++ b/tools/launch_cpu_job.sh
@@ -22,7 +22,9 @@
 THREADS=2
 
 usage() { sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }
-die() { echo "launch_cpu_job: $1" >&2; exit "${2:-1}"; }
+die() { echo "launch_cpu_job: $1" >&2; type cockpit_log >/dev/null 2>&1 && cockpit_log error --source cpu-job --exc-type die --message "launch_cpu_job: $1"; exit "${2:-1}"; }
